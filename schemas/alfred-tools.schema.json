{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AlfredToolCollection",
  "type": "object",
  "required": ["schemaVersion", "tools"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": "1.0"},
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path", "repository", "role", "verify", "installCapabilities"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "path": {"type": "string", "pattern": "^repos/[a-z0-9][a-z0-9-]*$"},
          "repository": {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\\.git$"},
          "role": {"enum": ["control-kit", "skill-pack", "dsh-domain-tool"]},
          "verify": {"enum": ["kit-tests", "skills-validate", "fin-tests"]},
          "installCapabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": {"enum": ["vault-control", "user-skills", "dsh-bundle-web", "dsh-bundle-headless"]}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
