// managed-by: mimo-alfred
// Placeholders: {{ALFRED_ROOT}}
import { existsSync, readdirSync } from "node:fs"
import { join } from "node:path"
import { fileURLToPath } from "node:url"
import { tool } from "@mimo-ai/plugin"
import { AlfredControlRuntime, CapabilityProbe, resolveAlfredActivation } from "../alfred-lib/index.js"

const ALFRED_ROOT = {{ALFRED_ROOT}}

function listInstalledSkills(): string[] {
  try {
    const dir = fileURLToPath(new URL("../skills/", import.meta.url))
    if (!existsSync(dir)) return []
    return readdirSync(dir, { withFileTypes: true })
      .filter((e) => e.isDirectory() && existsSync(join(dir, e.name, "SKILL.md")))
      .map((e) => e.name)
  } catch {
    return []
  }
}

function sessionFromCtx(ctx: { sessionID?: string; agent?: string; directory?: string }) {
  return {
    sessionId: String(ctx.sessionID || "unknown"),
    turnNumber: 0,
    turnId: String(ctx.sessionID || "unknown"),
    agentId: String(ctx.agent || "unknown"),
    isTopLevelHuman: true,
    isExcludedMode: ctx.agent === "plan",
    cwd: ctx.directory,
    modeName: String(ctx.agent || "build"),
  }
}

export default tool({
  description: "Query ALF managed capabilities and current session visibility (read-only).",
  args: {},
  async execute(_args, ctx) {
    const directory = (ctx as { directory?: string }).directory || process.cwd()
    const activation = resolveAlfredActivation(directory)
    if (!activation.enabled) {
      return JSON.stringify({ ok: false, error: "alfred-not-enabled-for-project", source: activation.source })
    }
    const session = sessionFromCtx(ctx as never)
    const probe = new CapabilityProbe({ alfredRoot: ALFRED_ROOT, ttlMs: 300_000, timeoutMs: 5_000 })
    const alf = new AlfredControlRuntime({ alfredRoot: ALFRED_ROOT, probe })
    const visibility = {
      async listVisibleSkills() {
        return listInstalledSkills().map((name) => ({ name }))
      },
      listVisibleTools() {
        return [{ name: "alfred_capabilities" }]
      },
    }
    return alf.handleCapabilities(session, visibility)
  },
})
