{
  "name": "mimo-alfred",
  "description": "Project-level MiMo Desktop installer for the ALF skill pack and tool runtime.",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/install.js",
