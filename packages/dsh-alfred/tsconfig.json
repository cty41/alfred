{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "jsx": "react-jsx",
    "outDir": "dist",
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "target": "ES2022",
    "types": ["node", "react"],
    "lib": ["ES2022", "DOM"],
    "composite": true,
    "paths": { "alfred-core": ["../alfred-core/src/index.ts"] }
  },
  "references": [{ "path": "../alfred-core" }],
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
